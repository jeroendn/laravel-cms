# Imported by the shared DockerServer Caddy via `import /apps/*/docker/caddy/Caddyfile`.
# Caddy terminates TLS and reverse-proxies everything to the php_magnesium
# Apache container, which serves the Laravel app from /var/www/html/public.
(defaults_magnesium) {
    reverse_proxy php_magnesium:80
}

magnesiumengezondheid.nl {
    import defaults_magnesium

    tls {
        on_demand
    }
}

magnesium.local {
    import defaults_magnesium

    tls internal {
        on_demand
    }
}
