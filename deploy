#!/usr/bin/env bash

set -e

NC="\e[0m"
SUCCESS="\e[42m"
WARNING="\e[43m"
ERROR="\e[41m"

CONTAINER_NAME="$(sed -n 's/^APP_CONTAINER=//p' .env 2>/dev/null | tail -n1 | tr -d "'\"")"
CONTAINER_NAME="${CONTAINER_NAME:-php_cms}"

trap 'echo -e "${ERROR}Deployment failed — the site is still in maintenance mode${NC}"
      echo -e "${WARNING}Fix the problem and re-run ./deploy, or force it back online with:${NC}"
      echo -e "${WARNING}  sudo docker exec -it ${CONTAINER_NAME} php artisan up${NC}"' ERR

GIT_BRANCH="master"
GIT_REMOTE="origin"

if [ "$EUID" -eq 0 ]; then
  echo -e "${ERROR}Do not run as sudo!${NC}"
  exit 1
fi

echo -e "${SUCCESS}Please enter your sudo password:${NC}"
sudo -v

echo -e "${SUCCESS}Enabling maintenance mode${NC}"
sudo docker exec -it $CONTAINER_NAME php artisan down --render="errors::503" --retry=180 \
  || echo -e "${WARNING}Could not enable maintenance mode (container not running?)${NC}"

echo -e "${SUCCESS}Pulling latest changes${NC}"
git reset --hard
git checkout $GIT_BRANCH
git fetch $GIT_REMOTE
git reset --hard $GIT_REMOTE/$GIT_BRANCH

echo -e "${SUCCESS}Setting executable permissions${NC}"
chmod +x ./deploy

echo -e "${SUCCESS}Rebuilding Docker image${NC}"
sudo docker compose build --no-cache --pull

echo -e "${SUCCESS}Restarting Docker containers${NC}"
sudo docker compose down --remove-orphans
sudo docker compose up -d

echo -e "${SUCCESS}Installing libraries${NC}"
sudo docker exec -it $CONTAINER_NAME composer install --no-dev --optimize-autoloader --no-interaction
sudo docker exec -it $CONTAINER_NAME npm ci
sudo docker exec -it $CONTAINER_NAME npm run build

echo -e "${SUCCESS}Running database migrations${NC}"
sudo docker exec -it $CONTAINER_NAME php artisan migrate --force --no-interaction --database=mariadb_migrations

echo -e "${SUCCESS}Caching Laravel config/routes/views${NC}"
sudo docker exec -it $CONTAINER_NAME php artisan optimize

# Apache runs as www-data, but the repo is bind-mounted: chowning these to
# www-data would put the tracked .gitignore files in directories this user can
# no longer unlink, so the next deploy's `git reset --hard` dies on them. Keep
# ownership here and grant www-data through the group instead. Runs last so it
# also covers what the steps above wrote as root inside the container.
echo -e "${SUCCESS}Setting writable app directories${NC}"
sudo chown -R "$(id -un):www-data" storage bootstrap/cache
sudo chmod -R g+rwX storage bootstrap/cache

echo -e "${SUCCESS}Disabling maintenance mode${NC}"
sudo docker exec -it $CONTAINER_NAME php artisan up

echo -e "${SUCCESS}Deployment finished${NC}"
